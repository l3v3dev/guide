{
  "private": true,
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
  "scripts": {
    "build": "npm --prefix browser-app run bundle",
    "buildprod": "npm --prefix browser-app run bundleprod",
    "prepare": "lerna run prepare",
    "postinstall": "theia check:theia-version",
    "start": "npm --prefix browser-app start",
    "watch": "lerna run --parallel watch --ignore electron-app"
  },
  "devDependencies": {
    "lerna": "2.4.0"
  },
  "workspaces": [
    "l3v3guide",
    "browser-app"
  ],
  "dependencies": {
    "drivelist": "^12.0.2"
  }
}
